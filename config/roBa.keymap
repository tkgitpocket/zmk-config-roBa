#include <layout_shift.dtsi>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

// zmk-layout-shift (https://github.com/kot149/zmk-layout-shift/blob/v2/README_ja.md)
// US配列のキーコードをJIS配列OS向けに変換する。旧JP_xxxマクロは廃止し、
// 標準キーコード + このモジュールによる変換に置き換えた(memos/zmk-layout-shift-v2-migration.md参照)。
// 初回フラッシュ後はBTレイヤーの&tog_ls_onを一度押して変換を有効化すること
// (CONFIG_LAYOUT_SHIFT_PERSISTENT_STATE=yにより設定は不揮発領域に保存される)。

&tog_ls { layout-maps = <&layout_shift_map_us_to_jis>; };

&tog_ls_on { layout-maps = <&layout_shift_map_us_to_jis>; };

&tog_ls_off { layout-maps = <&layout_shift_map_us_to_jis>; };

// レイヤー番号 (KeymapEditor互換のため数値リテラル直書き。マクロは使用しない)
// 0: DEFAULT_L        ベースQWERTYレイヤー
// 1: SYMBOL_L         記号・カッコ
// 2: MOUSE_CTRL_L     マウスボタン・矢印・クリップボード(Windows想定)
// 3: NUM_FUNCTION_L   数字・ファンクションキー
// 4: MOUSE_L          マウスボタンのみ
// 5: SCROLL_L         トラックボールスクロールモード(標準速度)
// 6: BT_L             Bluetoothプロファイル選択
// 7: APPLE_L          Apple(Mac/iOS)用デフォルトレイヤー
// 8: CENTER2_L        マウスボタン・矢印・クリップボード(Apple想定、CENTER2)
// 9: SLOWTRACKBALL_L  トラックボールカーソル低速モード(移行キー未割り当て)
// 10: SLOWSCROLL_L    トラックボールスクロール低速モード(移行キー未割り当て)
// 11: FASTRSCROLL_L   トラックボールスクロール高速モード(移行キー未割り当て)

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    mo2: mo2 {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp N2>, <&kp AT>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    mo6: mo6 {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp N6>, <&kp CARET>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    mo7: mo7 {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp N7>, <&kp AMPERSAND>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    mo8: mo8 {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp N8>, <&kp ASTERISK>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    mo9: mo9 {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp N9>, <&kp LPAR>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    mo0: mo0 {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp N0>, <&kp LS(N9)>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    moA: moA {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp MINUS>, <&kp UNDERSCORE>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    moB: moB {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp EQUAL>, <&kp PLUS>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    moC: moC {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp INT3>, <&kp PIPE>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    moD: moD {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LBKT>, <&kp LBRC>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    moE: moE {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACE>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    moF: moF {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp SEMI>, <&kp PLUS>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    moG: moG {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp APOSTROPHE>, <&kp DQT>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    moH: moH {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp INT1>, <&kp TILDE>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    moI: moI {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp INT1>, <&kp UNDERSCORE>;

        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // BTプロファイル選択時に他プロファイルを都度切断して接続を安定させ、
        // あわせてプロファイルに対応するデフォルトレイヤーに切り替える
        // (プロファイル0-1: Windows想定 → レイヤー0、2-4: Apple想定 → レイヤー7)
        // (ZMKは切断直後に選択中プロファイルへ自動的に再接続する)

        out_bt_0: out_bt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_SEL 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4 &to 0>;
        };

        out_bt_1: out_bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_SEL 1 &bt BT_DISC 0 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4 &to 0>;
        };

        out_bt_2: out_bt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_SEL 2 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 3 &bt BT_DISC 4 &to 7>;
        };

        out_bt_3: out_bt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_SEL 3 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 4 &to 7>;
        };

        out_bt_4: out_bt_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_SEL 4 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &to 7>;
        };
    };

    behaviors {
        // zmk-layout-shift用: KeymapEditor対策として&kpの上書きをここで直接定義
        // (includeの並び順をKeymapEditorが変更してしまうことがあるため)

        original_key_press: original_key_press {
            compatible = "zmk,behavior-key-press";
            #binding-cells = <1>;
            label = "KEY_PRESS";
        };

        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // エンコーダー: DYA Studioからレイヤー別に割り当て変更可能(未設定時はこの既定値=スクロール)
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        mouse_scroll: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };

        long_hold_mod_tap: long_hold_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LONG_HOLD_MOD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
            flavor = "tap-preferred";
        };

        medium_hold_mod_tap: medium_hold_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MEDIUM_HOLD_MOD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "0:default layer";
            bindings = <
&kp Q                            &kp W             &kp E         &kp R             &kp T                                               &kp Y              &kp U  &kp I      &lt 10 O     &lt 11 P
&kp A                            &kp S             &kp D         &kp F             &kp G        &kp LS(LG(S))           &kp RCTRL      &mt RIGHT_SHIFT H  &kp J  &kp K      &mt RCTRL L  &lt 5 MINUS
&long_hold_mod_tap LEFT_SHIFT Z  &kp X             &kp C         &kp V             &lt 4 B      &mo 9                   &kp TILDE      &kp N              &kp M  &mkp LCLK  &mkp RCLK    &long_hold_mod_tap RIGHT_SHIFT SLASH
&mt LEFT_SHIFT ESC               &mt LEFT_WIN TAB  &kp LEFT_ALT  &lt 1 INT_HENKAN  &lt 2 SPACE  &lt 3 INT_MUHENKAN      &kp BACKSPACE  &kp ENTER                                         &mt RIGHT_GUI BACKSLASH
            >;

            sensor-bindings = <&scroll_up_down>, <&scroll_up_down>;
        };

        symbol {
            display-name = "1:(left)symbol layer";
            bindings = <
&kp EXCLAMATION     &kp DOUBLE_QUOTES  &kp HASH      &kp DOLLAR      &kp PERCENT                                            &kp AMPERSAND  &kp SINGLE_QUOTE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp LCTRL           &kp SEMICOLON      &kp COLON     &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans                  &kp ASTERISK  &kp CARET      &kp AT            &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EQUAL
&mt LEFT_SHIFT TAB  &kp PLUS           &kp ASTERISK  &kp TILDE       &kp PRINTSCREEN  &mt LEFT_SHIFT TAB      &kp GRAVE     &kp SEMICOLON  &kp COLON         &kp LESS_THAN         &kp GREATER_THAN       &kp TILDE
&trans              &trans             &trans        &trans          &trans           &lt 1 INT_MUHENKAN      &kp RCTRL     &kp ENTER                                                                     &kp QUESTION
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        mouse_arrow_ctrl {
            display-name = "2:(center)move & shortcut layer";
            bindings = <
&kp TAB        &kp LEFT_ALT  &kp END    &lt 6 SPACE      &kp PRINTSCREEN                             &kp RC(Y)       &mkp MB4   &mkp MB3   &mkp MB5   &kp UP_ARROW
&kp HOME       &kp LC(S)     &kp DEL    &kp RIGHT_ARROW  &kp LEFT_SHIFT   &trans      &kp PAGE_UP    &kp BACKSPACE   &mkp LCLK  &mkp LCLK  &mkp RCLK  &mo 5
&kp LC(Z)      &kp LC(X)     &kp LC(C)  &kp LC(V)        &kp LEFT_ARROW   &mo 10      &kp PAGE_DOWN  &kp DOWN_ARROW  &trans     &mkp LCLK  &mkp RCLK  &kp ENTER
&studio_unlock &trans        &trans     &trans           &trans           &trans      &kp RCTRL      &kp ENTER                                        &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        num {
            display-name = "3:(right)number layer";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                                   &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &trans      &kp RCTRL            &kp F6        &kp F7        &kp F8        &kp F9        &kp UNDERSCORE
&kp F10       &kp F11       &kp F12       &trans        &trans        &mo 11      &kp CARET            &kp PLUS      &kp ASTERISK  &kp COMMA     &kp PERIOD    &kp SLASH
&trans        &trans        &trans        &trans        &trans        &trans      &kp INTERNATIONAL_4  &kp ENTER                                               &kp QUESTION
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            display-name = "4:mouse layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &mkp MB4   &mkp MB3   &mkp MB5   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp LCLK  &mkp LCLK  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &mkp LCLK  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                   &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            display-name = "5:scroll layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        bt {
            display-name = "6:bluetooth & config layer";
            bindings = <
&trans          &trans  &trans  &trans  &trans                                       &out_bt_0  &out_bt_1  &out_bt_2  &out_bt_3  &out_bt_4
&trans          &trans  &trans  &trans  &trans  &trans              &kp RA(RC(DEL))  &trans     &trans     &trans     &trans     &tog_ls_on
&studio_unlock  &trans  &trans  &trans  &trans  &bootloader      &bootloader      &trans     &trans     &trans     &trans     &bt BT_CLR
&trans          &trans  &trans  &trans  &trans  &trans              &trans           &trans                                      &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        apple_default_layer {
            display-name = "7:apple default layer";
            bindings = <
&trans  &trans  &trans        &trans            &trans                                     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &trans            &trans       &trans                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &trans            &trans       &trans                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT_GUI  &lt 1 LANGUAGE_1  &lt 8 SPACE  &lt 3 LANGUAGE_2      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>, <&scroll_up_down>;
        };

        center2_layer {
            display-name = "8:(center)move & shortcut layer for Apple";
            bindings = <
&kp TAB       &kp LEFT_ALT  &kp LG(RIGHT)  &lt 6 SPACE      &kp LS(LG(N5))                                     &kp LG(LS(Z))   &mkp MB4   &mkp MB3   &mkp MB5   &kp UP_ARROW
&kp LG(LEFT)  &kp LG(S)     &kp DEL        &kp RIGHT_ARROW  &kp LEFT_SHIFT  &trans              &kp PAGE_UP    &kp BACKSPACE   &mkp LCLK  &mkp LCLK  &mkp RCLK  &mo 5
&kp LG(Z)     &kp LG(X)     &kp LG(C)      &kp LG(V)        &kp LEFT_ARROW  &kp LEFT_SHIFT      &kp PAGE_DOWN  &kp DOWN_ARROW  &trans     &mkp LCLK  &mkp RCLK  &kp ENTER
&trans        &trans        &trans         &trans           &trans          &trans              &kp RCTRL      &kp ENTER                                        &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        slow_trackball_layer {
            display-name = "9:slow trackball layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &mkp MB4   &mkp MB3   &mkp MB5   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp LCLK  &mkp LCLK  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &mkp LCLK  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                   &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        slow_scroll_layer {
            display-name = "10:slow scroll layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        fast_scroll_layer {
            display-name = "11:fast scroll layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
